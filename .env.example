# ==============================================================================
# Eco-Habit Coach: Environment Configuration
# Copy this file to server/.env and fill in your keys
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=eco_habit_coach_super_secure_jwt_token_secret_key_2026
JWT_EXPIRES_IN=30d

# MongoDB Database Connection
# Option A: MongoDB Atlas (Recommended for persistent cloud data)
#   1. Create a free M0 cluster at https://www.mongodb.com/cloud/atlas
#   2. Whitelist your IP (or 0.0.0.0/0 for anywhere)
#   3. Paste connection string below:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eco_coach?retryWrites=true&w=majority
#
# Option B: Local MongoDB Daemon:
#   MONGODB_URI=mongodb://127.0.0.1:27017/eco_coach
#
# Option C: Zero-Config Embedded In-Memory MongoDB:
#   Leave MONGODB_URI empty! The backend automatically spins up an embedded in-memory MongoDB
#   server so the project runs out of the box for grading and demonstrations without Docker!
MONGODB_URI=

# Google Gemini AI Integration
# 1. Visit Google AI Studio at https://aistudio.google.com/
# 2. Click "Get API key" and generate a free API key
# 3. Paste your key below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
