# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=eco_habit_coach_super_secure_jwt_token_secret_key_2026
JWT_EXPIRES_IN=30d

# MongoDB Database Connection
# For Local MongoDB: mongodb://127.0.0.1:27017/eco_coach
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eco_coach?retryWrites=true&w=majority
# Note: If left unset or unreachable, the server automatically starts an embedded in-memory MongoDB instance for instant testing!
MONGODB_URI=

# Google Gemini AI Integration
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
